{
  email off
  admin off
}

{$PUBLIC_HOST} {
  encode zstd gzip

  reverse_proxy api:8000

  header {
    -Server
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "no-referrer"
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
  }

  log {
    output stdout
    format json
  }
}
