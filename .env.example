APP_ENV=production
APP_NAME=البحث العميق
API_TOKEN=replace-with-a-long-random-token
DATABASE_URL=postgresql+psycopg://deepsearch:deepsearch_local@postgres:5432/deepsearch
PUBLIC_BASE_URL=https://example.com
DATA_DIR=/data

SEARXNG_URL=http://searxng:8080
SEARCH_MAX_RESULTS=10
SEARCH_MAX_CANDIDATES=250
SEARCH_VERIFY_PAGES_PER_RUN=40
SEARCH_HTTP_TIMEOUT_SECONDS=15
SEARCH_MAX_ACTIVE_JOBS=2
SEARCH_IDLE_SLEEP_SECONDS=5
SEARCH_MAX_ATTEMPTS=48

VIDEO_MAX_UPLOAD_MB=250
VIDEO_MAX_KEYFRAMES=12
TEMP_FILE_TTL_HOURS=24

# WireGuard works at the server/network layer. Set this only when using a
# dedicated HTTP/SOCKS proxy that exits through the VPN namespace.
EGRESS_PROXY_URL=

GITHUB_REPOSITORY=Malik05255/HAI_SERCH
