APP_ENV=production
APP_NAME=البحث العميق
DATABASE_URL=postgresql+psycopg://deepsearch:deepsearch_local@postgres:5432/deepsearch
PUBLIC_BASE_URL=https://example.com
DATA_DIR=/data

SEARXNG_URL=http://searxng:8080
SEARCH_MAX_RESULTS=10
# Heuristic match score (0-100), not a probability. Lower carefully for very fuzzy searches.
SEARCH_MIN_RESULT_SCORE=12
SEARCH_MAX_CANDIDATES=250
SEARCH_VERIFY_PAGES_PER_RUN=40
SEARCH_HTTP_TIMEOUT_SECONDS=15
SEARCH_MAX_ACTIVE_JOBS=5
SEARCH_IDLE_SLEEP_SECONDS=5
SEARCH_MAX_ATTEMPTS=48
SEARCH_CONTINUE_ATTEMPT_FLOOR=8

# Local multilingual query planner. Cached per evidence set.
PLANNER_ENABLED=true
PLANNER_URL=http://planner:8082
PLANNER_TIMEOUT_SECONDS=75
PLANNER_MAX_QUERIES=6

# Uploads are validated from their actual bytes, not only filename/MIME.
IMAGE_MAX_UPLOAD_MB=30
IMAGE_MAX_PIXELS=80000000
VIDEO_MAX_UPLOAD_MB=250
VIDEO_MAX_DURATION_SECONDS=600
VIDEO_MAX_KEYFRAMES=12
VIDEO_TRANSCRIBE_MAX_SECONDS=300
OCR_LANGUAGES=eng+ara+deu+fra+spa+chi_sim+chi_tra+jpn+kor+rus+tur

# Local speech-to-text. whisper.cpp and the tiny model are built into the worker image.
WHISPER_ENABLED=true
WHISPER_CLI_PATH=/usr/local/bin/whisper-cli
WHISPER_MODEL_PATH=/opt/whisper.cpp/models/ggml-tiny.bin

# Local visual understanding. The vision container is private to Docker networking.
VISION_ENABLED=true
VISION_URL=http://vision:8081
VISION_MAX_FRAMES=4
VISION_TIMEOUT_SECONDS=90
VISUAL_HASH_MAX_DISTANCE=14

# Retained cloud media used by previous tasks. Local archives are not included here.
CLOUD_MEDIA_QUOTA_GB=20

# Unclaimed uploads older than this are deleted. Media referenced by any job is never removed by this cleanup.
TEMP_FILE_TTL_HOURS=24

# Optional Android completion notifications. Keep the service-account value only in the server environment.
NOTIFICATIONS_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_B64=

# Public web egress: auto prefers direct and falls back to a configured VPN
# only for network failures / HTTP 451. Internal Docker services stay direct.
EGRESS_MODE=auto
EGRESS_PROXY_URL=

GITHUB_REPOSITORY=Malik05255/HAI_SERCH
