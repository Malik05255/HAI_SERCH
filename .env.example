# Core
APP_ENV=production
APP_NAME=البحث العميق
DATABASE_URL=postgresql+psycopg://deepsearch:deepsearch@postgres:5432/deepsearch
PUBLIC_BASE_URL=https://example.com

# Search
SEARXNG_URL=http://searxng:8080
SEARCH_MAX_RESULTS=10
SEARCH_MAX_CANDIDATES=250
SEARCH_HTTP_TIMEOUT_SECONDS=15
SEARCH_BROWSER_BUDGET_PER_JOB=8
SEARCH_MAX_ACTIVE_JOBS=2
SEARCH_IDLE_SLEEP_SECONDS=5

# Media budgets
VIDEO_MAX_UPLOAD_MB=250
VIDEO_MAX_KEYFRAMES=12
AUDIO_TRANSCRIBE_MAX_MINUTES=20
TEMP_FILE_TTL_HOURS=24

# Optional object storage (Cloudflare R2 / S3-compatible)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=deep-search
R2_PUBLIC_BASE_URL=

# Notifications
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=

# Egress / VPN
# WireGuard is configured at the server/network layer. Optional proxy URL can
# point workers at a dedicated VPN namespace/gateway when dual routing is used.
EGRESS_PROXY_URL=

# Updates
GITHUB_REPOSITORY=Malik05255/HAI_SERCH
